# Public Firebase Web app settings (Firebase Console > Project settings > Your apps).
# Never put the Firebase Admin private key or MongoDB URI in frontend env files.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# Optional; development uses the Vite /api proxy.
# VITE_API_URL=http://localhost:4000/api
