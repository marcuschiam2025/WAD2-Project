# Copy to .env and fill in. Never commit the real .env.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bidmaxxer
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin service account (Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; newlines as \n
FIREBASE_PRIVATE_KEY=""

# Local development only: skip Firebase and trust the x-dev-uid header. Never enable in production.
AUTH_DEV_BYPASS=false
