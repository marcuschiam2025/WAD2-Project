# Copy to .env and fill in. Never commit the real .env.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bidmaxxer
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin service account (Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; newlines as \n
FIREBASE_PRIVATE_KEY=""

# Firebase web config, used by the temporary login test page at /test
# (Project settings → General → Web API key). Not secret, but keep it here rather than in code.
FIREBASE_WEB_API_KEY=

# Optional official bidding schedule. Blank uses the latest catalogue term as a preview.
# Term format: 2026-27_T1. Closing time must include a timezone.
BIDDING_TERM=
BIDDING_ROUND=
BIDDING_ROUND_CLOSES_AT=
